# Copy to .env.local (local dev) or add in Hostinger → Node.js app → Environment variables.
# Never commit real values.

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://umeriftikhar.online

# --- Contact form email (required) ---
# Gmail: EMAIL_USER is the Gmail address; EMAIL_PASSWORD must be a Google *App Password*
# (Google Account → Security → 2-Step Verification → App passwords), not your normal password.
EMAIL_USER=
EMAIL_PASSWORD=
# Where lead notifications are delivered (defaults to umer.iftikhar391@gmail.com)
CONTACT_TO_EMAIL=umer.iftikhar391@gmail.com

# Optional: use any SMTP server (e.g. Hostinger email) instead of Gmail.
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465

# --- Analytics ---
# Google Tag Manager container (GA4 is configured inside GTM). Defaults to GTM-59B86S87.
NEXT_PUBLIC_GTM_ID=GTM-59B86S87
# Optional: Meta Pixel ID. Leave empty if the Pixel is managed inside GTM.
NEXT_PUBLIC_META_PIXEL_ID=
